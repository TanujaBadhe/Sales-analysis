      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[Sample - Superstore].[ctd:Customer Name:qk]&quot;' value='Customers' />
          <alias key='&quot;[Sample - Superstore].[ctd:Order ID:qk]&quot;' value='Order' />
          <alias key='&quot;[Sample - Superstore].[usr:Calculation_1286475413975043:qk]&quot;' value='AOV' />
          <alias key='&quot;[Sample - Superstore].[usr:Calculation_1286475415191556:qk]&quot;' value='Ratio %' />
        </aliases>
      </column>
      <column caption='Averag order value' datatype='real' name='[Calculation_1286475413975043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])/COUNT([Order ID])' />
      </column>
      <column caption='Profit Ratio %' datatype='real' name='[Calculation_1286475415191556]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1368249927221915648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='Profit category' datatype='string' name='[Calculation_1382960395034624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Profit] &gt;0 THEN &apos;Profit&apos; ELSEIF [Profit]=0 THEN &apos;Breakeven&apos; ELSE &apos;Loss&apos; END' />
      </column>
      <column caption='Discount category' datatype='string' name='[Calculation_1382960406687745]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Discount]&gt;0.4 THEN &apos;Discount high&apos; ELSE &apos;Low Dicount&apos; END' />
      </column>
      <column caption='shipdatediff' datatype='integer' name='[Calculation_1382960423882754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Order Date], [Ship Date])' />
      </column>
      <column datatype='string' name='[Category]' role='dimension' type='nominal' />
